# Joy Senior Living — environment variables
# Copy this file to ".env.local" for local work, and set the same keys in
# Railway (Project > Variables) for production. Nothing here is secret until
# you fill in real values, so never commit your filled-in .env.local.

# --- Database (Railway Postgres) -------------------------------------------
# In Railway, reference the Postgres service's URL from the app service:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}   (Add Reference Variable)
# For local work, point at any Postgres instance.
DATABASE_URL=postgres://user:password@host:5432/joy
# The app applies the DB schema automatically on startup (idempotent), so no
# separate migrate step is needed. Set AUTO_MIGRATE=false to turn that off and
# run `npm run migrate` by hand instead.
# AUTO_MIGRATE=false

# --- Public site URL --------------------------------------------------------
# Used for canonical links, sitemap, robots Host, schema, and email unsubscribe
# links. The canonical host is www (non-www 301s to it at the DNS/host level),
# so keep the www prefix here or every canonical will point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://www.joyseniorcare.com
# Keep a host out of Google. Any *.railway.app host is noindexed automatically
# (no action needed), so this is only for OTHER preview URLs. Set to "true" to
# noindex every response; leave unset/empty on the live domain.
# SEO_NOINDEX=true

# --- Tour path (TalkFurther) ------------------------------------------------
# The single "Book a tour" destination for the whole site. The TalkFurther
# loader script (see src/components/MarketingScripts.tsx) is already installed
# on every public page; this value is what the "Book a tour" buttons open.
# Set it to the Further hash route so the buttons open the tour scheduler
# (instance 55), exactly like joyseniorcare.com does today:
#   NEXT_PUBLIC_TALKFURTHER_URL=/#/further/55
# Editable later in the admin (Site settings > Tour link). If left blank, the
# buttons fall back to the phone number so they never dead-end.
NEXT_PUBLIC_TALKFURTHER_URL=/#/further/55

# --- Email (Resend) ---------------------------------------------------------
# From resend.com. Optional: if unset, the site still saves leads, it just
# does not send confirmation/notification emails.
RESEND_API_KEY=
# Must be a verified sending domain in Resend (joyseniorcare.com).
EMAIL_FROM=Joy Senior Living <hello@joyseniorcare.com>
# Where new-lead alerts are sent (comma-separated for more than one).
LEAD_NOTIFY_TO=adam@joyseniorcare.com

# --- Texting (Quo / OpenPhone) ---------------------------------------------
# From quo.com (formerly OpenPhone). Optional: if unset, the Texts page still
# works but sending is off. The FROM number must be a Quo number registered for
# A2P 10DLC business texting.
QUO_API_KEY=
QUO_FROM_NUMBER=+14706843569
# Owner/admin numbers that must receive the required test before a family blast.
# Comma-separated; editable in the admin (Settings > Text test numbers).
SMS_TEST_NUMBERS=

# --- Admin login (Phase 2: Google OAuth, domain-restricted) ----------------
# Required for the /admin blog editor. Sign-in is Google-only and only
# @joyseniorcare.com accounts are allowed (enforced server-side).
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
# From a Google Cloud OAuth 2.0 Client (Web application). Set the authorized
# redirect URI to https://www.joyseniorcare.com/api/auth/callback/google
# (the canonical host is www; add the non-www URI too if you want it to work
# before the 301 fires).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: tighter control. Comma-separated exact emails. If set, ONLY these
# (and still @joyseniorcare.com) can sign in. If empty, any verified
# @joyseniorcare.com account works.
ADMIN_ALLOWLIST=

# TEMPORARY password login (a bridge until Google OAuth is deployed).
# Set ADMIN_PASSWORD to a strong secret to enable a shared-password sign-in on
# the /admin/login page. Leave it BLANK/unset to disable it and go back to
# Google-only (recommended for production). Remove it once Google works.
# Generate a strong one: openssl rand -base64 24
ADMIN_PASSWORD=
# Optional identity used for password logins (defaults to admin@joyseniorcare.com).
# If you use ADMIN_ALLOWLIST, add this address to it.
ADMIN_EMAIL=admin@joyseniorcare.com

# --- AI blog drafting (Phase 2: Anthropic) ---------------------------------
# Optional: enables the "Draft with AI" button in the editor. Without it, the
# editor still works, you just write posts by hand.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=

# --- Blog hero image generation (Gemini / Imagen) --------------------------
# Optional: enables the "Generate a hero image with Gemini" button in the blog
# editor. From aistudio.google.com. Generated images are saved to the same
# storage as uploads, so the S3_* vars below must also be set to use this.
GEMINI_API_KEY=
# Optional model override. Defaults to gemini-2.5-flash-image. The code auto-
# detects the API from the name: "gemini-*" uses generateContent, "imagen-*"
# uses the Imagen predict endpoint. Set this if your account exposes a different
# id, e.g. imagen-3.0-generate-002 or gemini-2.0-flash-preview-image-generation.
GEMINI_IMAGE_MODEL=

# --- Blog image uploads (Phase 2: S3 / Cloudflare R2) ----------------------
# Optional: enables uploading images in the editor. Without these, paste an
# image URL instead. Cloudflare R2 is the natural fit (S3-compatible).
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# PUBLIC base URL for the bucket, used to build image links the browser loads.
# This is NOT S3_ENDPOINT. Use the R2 public dev URL (https://pub-<hash>.r2.dev)
# or a custom domain (https://img.joyseniorcare.com), and turn on public access
# for the bucket. Using the r2.cloudflarestorage.com endpoint here makes images
# 401/403 and show the placeholder. See OPERATIONS.md ("I uploaded a photo…").
S3_PUBLIC_URL=

# --- Webflow migration (Phase 2, one-time) ---------------------------------
# Old URL base for existing Webflow blog posts, used to build 301 redirects
# (e.g. "/post" or "/blog"). Only used by scripts/import-webflow.mjs.
OLD_BLOG_BASE=/post

# --- Scheduled worker (Phase 3: Railway cron) ------------------------------
# Secret that guards /api/cron (sends due drip steps + scheduled emails).
# Generate with: openssl rand -hex 24. The Railway cron must send this as
# "Authorization: Bearer <secret>" or "?key=<secret>". Without it, /api/cron
# refuses to run, so it can never be triggered anonymously.
CRON_SECRET=

# Optional: turn off SSL for a local/self-hosted Postgres that doesn't use it
# (Railway Postgres uses SSL, so leave this unset there).
# PGSSL=false

# --- TalkFurther webhook reconciliation (Phase 5) --------------------------
# Secret that guards /api/webhooks/talkfurther. TalkFurther leads are piped
# into Postgres (source=talkfurther) so attribution sees every source. Set the
# same secret in the TalkFurther webhook config (Bearer, x-webhook-secret
# header, or ?key=). Generate: openssl rand -hex 24.
TALKFURTHER_WEBHOOK_SECRET=

# --- SEO rank logging (Phase 5) --------------------------------------------
# Optional: nightly Google rank logging via SerpApi (serpapi.com). Without it,
# the SEO page stays empty. Location biases results toward the local market.
SERPAPI_KEY=
SERPAPI_LOCATION=Georgia, United States

# --- Analytics (Phase 5) ---------------------------------------------------
# Optional, privacy-friendly (no cookies). Set to the site's domain to load
# Plausible and record conversions (tour clicks, form fills). Leave unset for
# no analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only change if self-hosting Plausible.
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js
