# Joy Senior Living — environment variables
# Copy this file to ".env.local" for local work, and set the same keys in
# Railway (Project > Variables) for production. Nothing here is secret until
# you fill in real values, so never commit your filled-in .env.local.

# --- Database (Railway Postgres) -------------------------------------------
# Railway sets DATABASE_URL automatically when you add a Postgres plugin.
# For local work you can point at any Postgres instance.
DATABASE_URL=postgres://user:password@host:5432/joy

# --- Public site URL --------------------------------------------------------
# Used for canonical links, sitemap, and email unsubscribe links.
NEXT_PUBLIC_SITE_URL=https://joyseniorcare.com

# --- Tour path (TalkFurther) ------------------------------------------------
# The single "Book a tour" destination for the whole site. Paste the real
# TalkFurther widget/scheduling URL. If left blank, the tour buttons fall back
# to the phone number so they never dead-end.
NEXT_PUBLIC_TALKFURTHER_URL=

# --- Email (Resend) ---------------------------------------------------------
# From resend.com. Optional: if unset, the site still saves leads, it just
# does not send confirmation/notification emails.
RESEND_API_KEY=
# Must be a verified sending domain in Resend (joyseniorcare.com).
EMAIL_FROM=Joy Senior Living <hello@joyseniorcare.com>
# Where new-lead alerts are sent (comma-separated for more than one).
LEAD_NOTIFY_TO=adam@joyseniorcare.com

# --- Admin login (Phase 2: Google OAuth, domain-restricted) ----------------
# Required for the /admin blog editor. Sign-in is Google-only and only
# @joyseniorcare.com accounts are allowed (enforced server-side).
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
# From a Google Cloud OAuth 2.0 Client (Web application). Set the authorized
# redirect URI to https://joyseniorcare.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: tighter control. Comma-separated exact emails. If set, ONLY these
# (and still @joyseniorcare.com) can sign in. If empty, any verified
# @joyseniorcare.com account works.
ADMIN_ALLOWLIST=

# --- AI blog drafting (Phase 2: Anthropic) ---------------------------------
# Optional: enables the "Draft with AI" button in the editor. Without it, the
# editor still works, you just write posts by hand.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=

# --- Blog image uploads (Phase 2: S3 / Cloudflare R2) ----------------------
# Optional: enables uploading images in the editor. Without these, paste an
# image URL instead. Cloudflare R2 is the natural fit (S3-compatible).
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Public base URL for the bucket (e.g. an R2 public/custom domain).
S3_PUBLIC_URL=

# --- Webflow migration (Phase 2, one-time) ---------------------------------
# Old URL base for existing Webflow blog posts, used to build 301 redirects
# (e.g. "/post" or "/blog"). Only used by scripts/import-webflow.mjs.
OLD_BLOG_BASE=/post
