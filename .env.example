# Joy Senior Living — environment variables
# Copy this file to ".env.local" for local work, and set the same keys in
# Railway (Project > Variables) for production. Nothing here is secret until
# you fill in real values, so never commit your filled-in .env.local.

# --- Database (Railway Postgres) -------------------------------------------
# Railway sets DATABASE_URL automatically when you add a Postgres plugin.
# For local work you can point at any Postgres instance.
DATABASE_URL=postgres://user:password@host:5432/joy

# --- Public site URL --------------------------------------------------------
# Used for canonical links, sitemap, and email unsubscribe links.
NEXT_PUBLIC_SITE_URL=https://joyseniorcare.com

# --- Tour path (TalkFurther) ------------------------------------------------
# The single "Book a tour" destination for the whole site. Paste the real
# TalkFurther widget/scheduling URL. If left blank, the tour buttons fall back
# to the phone number so they never dead-end.
NEXT_PUBLIC_TALKFURTHER_URL=

# --- Email (Resend) ---------------------------------------------------------
# From resend.com. Optional: if unset, the site still saves leads, it just
# does not send confirmation/notification emails.
RESEND_API_KEY=
# Must be a verified sending domain in Resend (joyseniorcare.com).
EMAIL_FROM=Joy Senior Living <hello@joyseniorcare.com>
# Where new-lead alerts are sent (comma-separated for more than one).
LEAD_NOTIFY_TO=adam@joyseniorcare.com
